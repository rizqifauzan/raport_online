# ============================================================
# Raport Online Pesantren — konfigurasi environment
# ============================================================
#
# Salin file ini menjadi `.env.local`, lalu isi DATABASE_URL.
#
# BIARKAN KOSONG / TIDAK ADA  → aplikasi jalan mode demo:
#   semua data hidup di memori browser dan reset setiap refresh.
#
# DIISI  → aplikasi otomatis pakai Neon Postgres:
#   data tersimpan permanen dan dibaca kembali saat halaman dibuka.
#
# Connection string ada di dashboard Neon → Project → Connection Details.
# Gunakan yang "Pooled connection" dan pastikan diakhiri `?sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Opsional — pemisah data bila satu database dipakai beberapa pesantren.
# Default: "default"
# APP_TENANT_ID="ponpes-al-hikmah"

# ============================================================
# Autentikasi
# ============================================================
#
# Kunci penandatangan cookie sesi. WAJIB di-set di produksi — kalau kosong
# dipakai kunci bawaan yang bisa ditebak siapa saja.
# Buat nilai acak: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Akun darurat untuk masuk pertama kali (dan bila semua admin terkunci).
# Akun ini TIDAK tersimpan di database; hanya hidup selama env ini di-set.
# Bila AUTH_ADMIN_PASSWORD dikosongkan, dipakai "admin123" — ganti sebelum dipakai sungguhan.
AUTH_ADMIN_USERNAME="admin"
AUTH_ADMIN_PASSWORD="ganti-password-ini"
